{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-planner-provisioning-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROVISIONING_TRANSACTION", "class_name": "ProvisioningTransaction" },
      { "name": "MANAGEMENT_ACCOUNT_PROJECT", "class_name": "ManagementAccountProject" }
    ]
  },
  "migrations": [
    { "tag": "provisioning-transaction-v1", "new_sqlite_classes": ["ProvisioningTransaction"] },
    { "tag": "management-account-project-v1", "new_sqlite_classes": ["ManagementAccountProject"] }
  ],
  "secrets": {
    "required": [
      "POC_PHASE",
      "POC_ORGANIZATION_SLUG",
      "POC_PROJECT_NAME",
      "POC_PROJECT_REF",
      "OAUTH_SESSION_KEY",
      "SUPABASE_OAUTH_CLIENT_ID",
      "SUPABASE_OAUTH_CLIENT_SECRET",
      "SUPABASE_OAUTH_REDIRECT_URI"
    ]
  }
}
