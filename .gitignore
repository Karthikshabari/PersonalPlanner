# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ / Android Studio related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/node_modules/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.kotlin/

# Linux desktop ephemeral build output
/linux/flutter/ephemeral/

# Test and coverage output
/coverage/

# Release-gate reports contain machine-local logs and are not source artifacts.
/artifacts/release-gate/

# Release bundles and generated distribution artifacts are machine-local.
/release/

# Keep only the root README in GitHub; other Markdown is local planning/report
# material and must not be staged accidentally.
*.md
!/README.md

# Local environment and credentials
.env
.env.*
!.env.example
/supabase.local.json

# Local SQLite runtime files
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Supabase CLI local state (migrations/config remain version-controlled)
/supabase/.branches/
/supabase/.temp/
# Android production signing material is machine-local and must never be
# committed or included in build artifacts.
android/key.properties
android/*.jks
android/*.keystore
android/*.p12
android/*.pem
